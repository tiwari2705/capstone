# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (Resend API — https://resend.com)
# SMTP on Render is blocked; Resend uses HTTPS (port 443) instead.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The "from" address must use a domain you've verified in Resend.
# For testing without a domain, use: CodeQuest <onboarding@resend.dev>  (sends only to your own email)
EMAIL_FROM=CodeQuest <you@yourdomain.com>

# Email Development Mode (set to 'true' to log OTPs to console instead of sending emails)
EMAIL_DEV_MODE=true

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Backend URL (for self-ping keep-alive on Render)
BACKEND_URL=

# Redis Configuration (optional - app works without it but with reduced performance)
REDIS_URL=
